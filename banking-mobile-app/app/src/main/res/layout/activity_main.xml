<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Banking Platform"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnFundsTransfer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Funds Transfer"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnDeposit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deposit"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnBalanceCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Balance Check"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAccountInquiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Account Inquiry"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnTransactionHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transaction History" />

        <!-- Screens (initially hidden, shown on button click) -->

        <LinearLayout
            android:id="@+id/screenBalanceCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balance Check"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <EditText
                android:id="@+id/inputAccountNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Account Number" />

            <Button
                android:id="@+id/btnCheckBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check Balance" />

            <TextView
                android:id="@+id/tvBalanceResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/screenAccountInquiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Inquiry"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <EditText
                android:id="@+id/inputInquiryAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Account Number" />

            <Button
                android:id="@+id/btnInquire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inquire" />

            <TextView
                android:id="@+id/tvInquiryResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/screenFundsTransfer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Funds Transfer"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <EditText
                android:id="@+id/inputDebitAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Debit Account Number" />

            <EditText
                android:id="@+id/inputCreditAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Credit Account Number" />

            <EditText
                android:id="@+id/inputAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Amount"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/inputCurrency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Currency (INR/USD)" />

            <Button
                android:id="@+id/btnTransfer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transfer" />

            <TextView
                android:id="@+id/tvTransferResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/screenDeposit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deposit"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <EditText
                android:id="@+id/inputDepositAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Account Number" />

            <EditText
                android:id="@+id/inputDepositAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Amount"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/inputDepositDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Description" />

            <Button
                android:id="@+id/btnDepositSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submit Deposit" />

            <TextView
                android:id="@+id/tvDepositResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/screenTransactionHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transaction History"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <EditText
                android:id="@+id/inputHistoryAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Account Number" />

            <Button
                android:id="@+id/btnGetMiniStatement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get Mini Statement" />

            <TextView
                android:id="@+id/tvHistoryResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
